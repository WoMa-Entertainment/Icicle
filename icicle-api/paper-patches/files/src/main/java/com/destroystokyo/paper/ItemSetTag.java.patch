+package com.destroystokyo.paper;
+
+import com.google.common.collect.Lists;
+import io.papermc.paper.tag.BaseTag;
+import org.bukkit.NamespacedKey;
+import org.bukkit.Registry;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.ItemType;
+import org.jetbrains.annotations.ApiStatus;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.Collection;
+import java.util.Set;
+import java.util.function.Predicate;
+import java.util.stream.Collectors;
+
+public class ItemSetTag extends BaseTag<ItemType, ItemSetTag> {
+
+    /**
+     * @deprecated Use NamespacedKey version of constructor
+     */
+    @Deprecated
+    public ItemSetTag(@NotNull Predicate<ItemType> filter) {
+        this(null, Registry.ITEM.stream().filter(filter).collect(Collectors.toList()));
+    }
+
+    /**
+     * @deprecated Use NamespacedKey version of constructor
+     */
+    @Deprecated
+    public ItemSetTag(@NotNull Collection<ItemType> materials) {
+        this(null, materials);
+    }
+
+    /**
+     * @deprecated Use NamespacedKey version of constructor
+     */
+    @Deprecated
+    public ItemSetTag(@NotNull ItemType... materials) {
+        this(null, materials);
+    }
+
+    public ItemSetTag(@Nullable NamespacedKey key, @NotNull Predicate<ItemType> filter) {
+        this(key, Registry.ITEM.stream().filter(filter).collect(Collectors.toList()));
+    }
+
+    public ItemSetTag(@Nullable NamespacedKey key, @NotNull ItemType... materials) {
+        this(key, Lists.newArrayList(materials));
+    }
+
+    public ItemSetTag(@Nullable NamespacedKey key, @NotNull Collection<ItemType> materials) {
+        this(key != null ? key : NamespacedKey.randomKey(), materials, (_) -> true);
+    }
+
+    public ItemSetTag(@Nullable NamespacedKey key, @NotNull Collection<ItemType> materials, @NotNull Predicate<ItemType>...globalPredicates) {
+        super(ItemType.class, key != null ? key : NamespacedKey.randomKey(), materials, globalPredicates);
+    }
+
+    @NotNull
+    @Override
+    @ApiStatus.Internal
+    protected Set<ItemType> getAllPossibleValues() {
+        return Registry.ITEM.stream().collect(Collectors.toSet());
+    }
+
+    @Override
+    @NotNull
+    @ApiStatus.Internal
+    protected String getName(@NotNull ItemType value) {
+        return value.key().asMinimalString();
+    }
+
+    public boolean isTagged(@NotNull ItemStack item) {
+        return isTagged(item.getType());
+    }
+
+    @Override
+    public boolean isTagged(@NotNull ItemType material) {
+        return super.isTagged(material);
+    }
+}
